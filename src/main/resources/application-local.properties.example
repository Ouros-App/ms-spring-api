# ===================================================================
# Template de Configuracoes Locais de Desenvolvimento
# Instrucoes: Copie este arquivo para 'application-local.properties'
# e preencha com as credenciais do seu banco de dados local/QA.
# ===================================================================

spring.datasource.url=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
spring.datasource.username=<USERNAME>
spring.datasource.password=<PASSWORD>
spring.datasource.driver-class-name=org.postgresql.Driver

# Configurações de Segurança (OAuth2 Resource Server / Keycloak)
spring.security.oauth2.resourceserver.jwt.issuer-uri=https://ouros-keycloak.discloud.app/realms/ouros
spring.security.oauth2.resourceserver.jwt.jwk-set-uri=https://ouros-keycloak.discloud.app/realms/ouros/protocol/openid-connect/certs
app.security.oauth2.audience=ms-spring-api
app.security.oauth2.client-id=ms-spring-api
app.cors.allowed-origins=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Configurações do Redis NoSQL (Upstash)
app.redis.host=rapid-hare-284662.upstash.io
app.redis.port=6379
app.redis.password=<UPSTASH_REDIS_REST_TOKEN>
app.redis.ssl.enabled=true
