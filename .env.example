SERVER_PORT=8000
DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
DB_USERNAME=<USERNAME>
DB_PASSWORD=<PASSWORD>

# URL pública do Audience Engine; pode ser substituída no ambiente de execução.
AUDIENCE_ENGINE_URL=https://ouros-audience.discloud.app

# Dedicated service account allowed to scrape /metrics.
METRICS_KEYCLOAK_AUTHORIZED_PARTY=ouros-prometheus

# Chave secreta compartilhada para chamadas M2M internas (/internal/v1/**)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-key-min-32-chars
INTERNAL_SERVICE_KEY=your-internal-service-secret-key-min-32-chars

# Redis NoSQL (Upstash / Redis gerenciado para rankings)
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<HOST>:6379

# Cron para recálculo agendado do ranking de fazendas (opcional, padrão a cada 7 dias)
app.ranking.cron=0 0 0 */7 * *

